# 统一编码，避免有人用 UTF-8 打开 GBK 的批处理把中文写坏
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,css,html,json,yml,yaml}]
indent_size = 2

[*.py]
max_line_length = 120

# 批处理是 GBK + CRLF，别让编辑器自作主张
[*.bat]
charset = gbk
end_of_line = crlf
indent_style = space
indent_size = 2

[*.ps1]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
