# 注意：后面的规则会覆盖前面的，所以通配放最上面
* text=auto

# 批处理是 GBK 编码，必须原样保留字节，不能做编码/换行转换
*.bat -text

*.png binary
*.ico binary

# PowerShell 脚本保持 CRLF
*.ps1 text eol=crlf

# 其余按文本处理，统一 LF
*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
